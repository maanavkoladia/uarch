$timescale
 1s
$end

$scope module tb_ramcell $end
$var reg        3 0    A [2:0] $end
$var reg        8 1    DIN [7:0] $end
$var reg        1 2    WR $end
$var reg        1 3    OE $end
$var wire       8 4    DOUT [7:0] $end

$scope begin unnamed$$_0 $end
$upscope $end

$scope begin unnamed$$_1 $end
$upscope $end

$scope module uut $end
$var wire       3 9    A [2:0] $end
$var wire       8 :    DIN [7:0] $end
$var wire       1 7    WR $end
$var wire       1 8    OE $end
$var reg        8 "    DOUT [7:0] $end
$var reg        8 #    ramout [7:0] $end
$var reg        3 $    lastread_addr [2:0] $end
$var reg        3 %    lastwrite_addr [2:0] $end
$var reg        1 &    wr_cycle_check $end
$var reg        1 '    read_cycle_check $end
$var reg        1 (    addr_hold_flag $end
$var reg        1 )    addr_setup_flag $end
$var reg        1 *    data_hold_flag $end
$var reg        1 +    data_setup_flag $end
$var reg        1 ,    din_changed $end
$var reg        1 -    a_changed $end
$var reg        1 .    output_enable $end
$var event      1 /    addr_unstable_memory $end

$scope begin write_block $end

$scope begin wr_dout $end
$upscope $end

$scope begin wr_mem $end
$upscope $end

$scope begin in_dout $end
$upscope $end

$scope begin din_mem $end
$upscope $end
$upscope $end

$scope begin a_dout $end
$upscope $end

$scope begin output_something $end
$upscope $end
$upscope $end
$upscope $end
$enddefinitions $end
