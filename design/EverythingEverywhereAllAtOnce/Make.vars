PROJECT_ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

include $(PROJECT_ROOT)/scripts/Make.scripts

CC = vcs

SUPPRESS_WARNING_LIST = \
    -suppress=SV-LCM-PPWI   \
    -suppress=ENUMASSIGN \

CC_FLAGS = \
    -sverilog   \
    -full64     \
    -debug_acc+all \
    -debug_region+cell+encrypt  \
    -timescale=1ns/1ps  \
    $(SUPPRESS_WARNING_LIST)    \
    -j8


SIM_TOOL = dve  \

SIM_TOOL_FLAGS  = \
    -full64     \

