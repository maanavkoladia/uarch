PROJECT_ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

CC = vcs

SUPPRESS_WARNING_LIST = \
    -suppress=SV-LCM-PPWI   \
    -suppress=ENUMASSIGN \

CC_FLAGS = \
    -sverilog   \
    -full64     \
    -debug_acc+all \
    -debug_region+cell+encrypt  \
    $(SUPPRESS_WARNING_LIST)


SIM_TOOL = dve  \

SIM_TOOL_FLAGS  = \
    -full64     \

