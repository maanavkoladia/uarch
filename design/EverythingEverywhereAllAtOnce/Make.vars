PROJECT_ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

include $(PROJECT_ROOT)/scripts/Make.scripts

CC = vcs

SUPPRESS_WARNING_LIST = \
    -suppress=SV-LCM-PPWI   \
    -suppress=ENUMASSIGN \

LINT_FLAGS_LIST = \
    +lint=TFIPC-L   \
    +lint=PCWM \

    #+lint=all \
    #+warn=all

CC_FLAGS = \
    $(LINT_FLAGS_LIST) \
    -full64     \
    -debug_acc+all \
    -debug_region+cell+encrypt  \
    -timescale=1ns/1ps  \
    -j8 \
    $(SUPPRESS_WARNING_LIST) \
    +lint=PCWM \

ifeq ($(STRUCTRURAL), true)
    CC_FLAGS += -v2005
    CC_FLAGS += -sverilog
else
    CC_FLAGS += -sverilog
endif

SIM_TOOL = dve  \

SIM_TOOL_FLAGS  = \
    -full64     \

PYTHON = python3.11

