PROJECT_ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

CC = vcs

SUPPRESS_WARNING_LIST = \
    -suppress=SV-LCM-PPWI   \
    -suppress=ENUMASSIGN \

CC_FLAGS = \
    -sverilog   \
    -full64     \
    -debug_acc+all \
    -debug_region+cell+encrypt  \
    -timescale=1ns/1ps  \
    $(SUPPRESS_WARNING_LIST)    \
    -j8


SIM_TOOL = dve  \

SIM_TOOL_FLAGS  = \
    -full64     \

LOAD_MEM_COMPILE_SCRIPT = $(PROJECT_ROOT)/Loadmem/compile.py
LOAD_MEM_GEN_HEX_MEM_SCRIPT = $(PROJECT_ROOT)/Loadmem/genHexMem.py
LOAD_MEM_GEN_READ_MEM_FILE = $(PROJECT_ROOT)/Loadmem/genReadMemFile.py
